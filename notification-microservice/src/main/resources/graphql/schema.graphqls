# ╔══════════════════════════════════════════════════════════════════════════════════╗
# ║  GraphQL Schema — Notification Service                                         ║
# ║                                                                                 ║
# ║  Interview: "What is GraphQL and how does it differ from REST?"                 ║
# ║  → "GraphQL is a QUERY LANGUAGE for APIs. Clients specify exactly which         ║
# ║     fields they need, solving REST's over-fetching and under-fetching:          ║
# ║       REST:    GET /api/v1/notifications → returns ALL 15 fields always         ║
# ║       GraphQL: query { notification(id:1) { title, status } } → just 2 fields  ║
# ║                                                                                 ║
# ║     Key differences:                                                            ║
# ║       REST    → multiple endpoints, HTTP verbs, fixed response shape            ║
# ║       GraphQL → single endpoint (/graphql), POST only, client-driven shape      ║
# ║                                                                                 ║
# ║     When to use which?                                                          ║
# ║       REST    → simple CRUD, caching (HTTP cache), public APIs                  ║
# ║       GraphQL → complex nested data, mobile (bandwidth), microservice BFF"      ║
# ╚══════════════════════════════════════════════════════════════════════════════════╝

# ── Types ────────────────────────────────────────────────────────────────────────

type Notification {
    id: ID!
    recipientId: String!
    title: String!
    message: String!
    channelType: ChannelType!
    status: NotificationStatus!
    priority: Priority!
    templateName: String
    sentAt: String
    readAt: String
    createdDate: String!
}

# Enums map directly to Java enums
enum ChannelType {
    EMAIL
    SMS
    PUSH
    IN_APP
}

enum NotificationStatus {
    PENDING
    PROCESSING
    SENT
    DELIVERED
    READ
    FAILED
    CANCELLED
}

enum Priority {
    LOW
    NORMAL
    HIGH
    URGENT
}

# ── Pagination wrapper ──────────────────────────────────────────────────────────

type NotificationPage {
    content: [Notification!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
    hasNext: Boolean!
}

# ── Queries (READ operations) ────────────────────────────────────────────────────

type Query {
    """Get a single notification by ID"""
    notification(id: ID!): Notification

    """Get notifications for a specific recipient with pagination"""
    notificationsByRecipient(
        recipientId: String!
        page: Int = 0
        size: Int = 10
    ): NotificationPage!

    """Search notifications with dynamic filters"""
    searchNotifications(
        recipientId: String
        channelType: ChannelType
        status: NotificationStatus
        priority: Priority
        searchTerm: String
        page: Int = 0
        size: Int = 10
    ): NotificationPage!

    """Get unread notification count for a user"""
    unreadCount(recipientId: String!): Int!
}

# ── Mutations (WRITE operations) ─────────────────────────────────────────────────

type Mutation {
    """Create a new notification"""
    createNotification(input: CreateNotificationInput!): Notification!

    """Mark a notification as read"""
    markAsRead(id: ID!): Notification!

    """Mark all notifications as read for a user"""
    markAllAsRead(recipientId: String!): Boolean!

    """Delete a notification"""
    deleteNotification(id: ID!): Boolean!
}

# ── Input types (for mutations) ──────────────────────────────────────────────────

input CreateNotificationInput {
    recipientId: String!
    title: String!
    message: String!
    channelType: ChannelType!
    priority: Priority = NORMAL
    templateName: String
}
