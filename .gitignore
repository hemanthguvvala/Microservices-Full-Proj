yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
dist/
build/
.cache/

# ── Angular ──
.angular/
*.tsbuildinfo

# ── IDE / Editors ──
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

