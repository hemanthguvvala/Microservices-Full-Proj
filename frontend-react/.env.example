# Environment Variables for Development
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=http://localhost:8081

# Sentry (Error Tracking)
VITE_SENTRY_DSN=your-sentry-dsn-here

# Feature Flags
VITE_FEATURE_REDUX=true
VITE_FEATURE_REACT_QUERY=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_I18N=true
VITE_FEATURE_FILE_UPLOAD=true

# Analytics
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# App Configuration
VITE_APP_NAME=Employee Management System
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Session
VITE_SESSION_TIMEOUT=3600000
